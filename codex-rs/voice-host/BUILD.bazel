load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "voice-host",
    binaries_with_build_commit = ["codex-voice-host"],
    # The helper also runs outside the compiler installation, including copied
    # packages. GNU LLVM's unwinder must not depend on an ambient libunwind.dll.
    binary_rustc_flags_extra = {
        "codex-voice-host": select({
            "@llvm//constraints/windows/abi:gnullvm": [
                "-C",
                "target-feature=+crt-static",
            ],
            "//conditions:default": [],
        }),
    },
    crate_name = "codex_voice_host",
    crate_srcs = [],
    unit_test_args = ["--test-threads=1"],
)

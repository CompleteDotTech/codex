     use super::*;
+
+    #[cfg(windows)]
+    #[test]
+    fn test_response_files_preserve_decoded_arguments() -> Result<(), Box<dyn std::error::Error>> {
+        let directory = std::env::temp_dir().join(format!(
+            "rules-rust-response-files-{}-{}",
+            std::process::id(),
+            SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos(),
+        ));
+        fs::create_dir(&directory)?;
+        let _cleanup = TemporaryDirectoryGuard::new(Some(directory.clone()));
+        let arguments = [
+            "",
+            "-Lnative=C:\\sdk\\lib\\\n-Lnative=C:\\sdk\\lib\\\\\n--cfg=sentinel\n-Lnative=C:\\sdk\\final\\",
+        ];
+        for (index, contents) in arguments.iter().enumerate() {
+            let path = directory.join(format!("{index}.args.expanded"));
+            fs::write(&path, contents)?;
+            let filtered = format!("{}.filtered", path.display());
+            let actual = get_dependency_search_paths_from_args(&[format!("@{}", path.display())])?;
+            assert_eq!(actual, (Vec::<PathBuf>::new(), vec![format!("@{filtered}")]));
+            assert_eq!(fs::read_to_string(filtered)?, *contents);
+        }
+        Ok(())
+    }
